# ============================================================
# 共事智能 (HAFlow) 官网业务线索通知配置
# ============================================================

# 1. 企业微信群机器人 Webhook（强烈推荐 · 核心获客线索即时推送到企微群）
# 获取步骤：
#   1) 打开企业微信，进入或创建一个专属群聊（如：“官网线索与业务诊断跟进群”）
#   2) 点击群设置 -> 添加群机器人 -> 新建机器人（命名为“共事官网线索助手”）
#   3) 复制 Webhook 地址粘贴在下方即可
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_wecom_key_here

# 2. （可选）飞书群机器人 Webhook
# 如果团队也需要同步推送到飞书群，在飞书群中添加自定义机器人并将 Webhook 填在下方
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_feishu_key_here

# ============================================================
# SEO / 百度搜索资源平台配置（百度视角必备）
# ============================================================

# 3. 真实 ICP 备案号（取得后填写，页脚自动展示；留空则显示“ICP备案审核中”，避免假号被百度降权）
# NEXT_PUBLIC_ICP_BEIAN=沪ICP备2025XXXXXX号-1

# 4. 百度站长验证 token（https://ziyuan.baidu.com/site/siteinfo 获取后填写）
# NEXT_PUBLIC_BAIDU_VERIFICATION=your_baidu_site_verification_code

# 5. 百度统计 ID（https://tongji.baidu.com 获取 hm.js id 后填写）
# NEXT_PUBLIC_BAIDU_TONGJI_ID=your_baidu_tongji_id

# 6. 百度主动推送 token（https://ziyuan.baidu.com 资源提交 -> 普通收录 -> API提交）
# BAIDU_PUSH_TOKEN=your_baidu_push_token
